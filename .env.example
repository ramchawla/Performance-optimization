# Copy to .env.local and fill in after Phase 0 Supabase setup.
# Never commit .env.local — it's already in .gitignore.

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server/Edge Function use ONLY. Never expose to the
# client. Used by scripts/seed-exercises.ts and Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=

# Free key from https://api.data.gov/signup (USDA FoodData Central) — Phase 2
USDA_API_KEY=

# Strava API app credentials — Phase 4 (developers.strava.com)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Sentry (optional — the app runs fine with these unset; instrumentation.ts
# and instrumentation-client.ts no-op without a DSN). Free tier: 5K
# errors/month, one project, no card. sentry.io -> New Project -> Next.js.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed in CI/Vercel for source-map upload at build time, not locally.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
