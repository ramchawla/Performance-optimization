<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs the Performance Hub coach every morning at 07:30 local time.
     If the Mac is asleep at 07:30, launchd runs it at next wake.
     Install/uninstall: see scripts/coach/README.md. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.perfhub.coach</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/ramchawla/Desktop/coding/Performance-optimization/scripts/coach/run-coach.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/ramchawla/Library/Logs/perfhub-coach.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ramchawla/Library/Logs/perfhub-coach.log</string>
</dict>
</plist>
